# --- Gemini ---
GEMINI_API_KEY=AQ.Ab8RN6Kgyf-yn-D1dW_0Qqq03GadxSr9lZesI_mtUiPwdDtNkg

# --- Google OAuth (Classroom, Calendar, Drive) ---
# Get these from https://console.cloud.google.com/apis/credentials
# Enable: Google Classroom API, Google Calendar API, Google Drive API
# Set redirect URI to http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Microsoft Graph (Teams) ---
# Get these from https://portal.azure.com > App Registrations
# Enable: Microsoft Graph > Team.Read, Assignment.Read
MICROSOFT_CLIENT_ID=xxxx
MICROSOFT_CLIENT_SECRET=xxxx
MICROSOFT_TENANT_ID=common

# --- Database ---
# Install PostgreSQL + pgvector extension:
#   CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://localhost:5432/automate

# --- CORS ---
FRONTEND_URL=http://localhost:5173
